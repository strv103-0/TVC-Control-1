# Normalize text to LF in the repo, check out native on Windows.
* text=auto

# Source files: always LF inside the repo
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.ino    text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.ini    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Windows-only scripts keep CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# KiCad / CAD / binaries: never touch line endings
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_pro   text eol=lf
*.step   binary
*.stl    binary
*.f3d    binary
*.sldprt binary
*.sldasm binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.zip    binary
